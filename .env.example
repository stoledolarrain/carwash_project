# Variables de docker-compose.yml (raíz). Copiar como .env y completar.
# Los microservicios dentro de Docker NO usan sus propios .env: toman todo de aquí.

# Contraseña del usuario postgres del contenedor. Usar solo letras y números (va dentro de URLs).
POSTGRES_PASSWORD=cambia-esto-solo-letras-y-numeros

# Secreto JWT compartido por Identity, el Gateway y todos los microservicios (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave secreta de Django para Customer.
DJANGO_SECRET_KEY=cambia-esto-por-otra-clave-larga-y-aleatoria

# Administrador inicial que crea Identity si la base está vacía (contraseña: 8+ caracteres con letras y números).
ADMIN_EMAIL=admin@carwash.local
ADMIN_PASSWORD=Admin12345

# Puerto del frontend en la máquina (cambiarlo si 5173 ya está en uso).
FRONTEND_PORT=5173
