# Servidor HTTP de Notification Service
PORT=3004

# PostgreSQL: base de datos propia de Notification (carwash_notifications).
# Copiar este archivo como .env y reemplazar TU_CONTRASEÑA por la del usuario postgres.
# La base debe existir (crearla en pgAdmin); la tabla "notifications" se crea sola al arrancar.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_CONTRASEÑA
DB_NAME=carwash_notifications

# JWT de Identity Service: deben ser EXACTAMENTE los mismos valores de identity/.env y api-gateway/.env.
# Obligatorio: sin JWT_SECRET el servicio no arranca.
JWT_SECRET=copiar-el-mismo-JWT_SECRET-de-identity
JWT_ISSUER=carwash-identity
JWT_AUDIENCE=carwash-platform

# Apache Kafka: Notification escucha los eventos de Wash Order y de Payment.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service-group
KAFKA_TOPICS=wash-order.order.events,payment.payment.registered
