# Servidor HTTP del Gateway (punto de entrada único: el frontend solo habla con este puerto)
NODE_ENV=development
PORT=8080

# JWT: deben ser EXACTAMENTE los mismos valores que usa Identity Service (identity/.env)
JWT_SECRET=copiar-el-mismo-JWT_SECRET-de-identity
JWT_ISSUER=carwash-identity
JWT_AUDIENCE=carwash-platform

# URLs de los microservicios. En Docker se reemplazan por el nombre del contenedor (p. ej. http://identity:3001)
IDENTITY_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
CUSTOMER_SERVICE_URL=http://localhost:3005
WASH_ORDER_SERVICE_URL=http://localhost:3000
PAYMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# Orígenes del frontend permitidos por CORS, separados por coma (Vite usa el puerto 5173 por defecto)
CORS_ORIGINS=http://localhost:5173

# Tiempo máximo de espera de un microservicio (ms)
PROXY_TIMEOUT_MS=10000

# Límite global de solicitudes por IP
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
