# Servidor HTTP
PORT=3000

# PostgreSQL (Base de datos de Wash Order Service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=carwash1

# Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=wash-order-service
KAFKA_ORDER_EVENT_TOPIC=wash-order.order.events

# JWT de Identity Service: deben ser EXACTAMENTE los mismos valores de identity/.env y api-gateway/.env.
# Obligatorio: sin JWT_SECRET el servicio no arranca.
JWT_SECRET=copiar-el-mismo-JWT_SECRET-de-identity
JWT_ISSUER=carwash-identity
JWT_AUDIENCE=carwash-platform
