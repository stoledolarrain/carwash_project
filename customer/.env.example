# Servidor HTTP de Customer / Vehicle Service
APP_ENV=development
PORT=3003
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-propia-de-django
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (base de datos exclusiva de Customer: customer_db)
# Reemplaza TU_PASSWORD por tu contraseña local en el archivo .env (ignorado por Git)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/customer_db

# JWT: debe coincidir exactamente con Identity Service y API Gateway
JWT_SECRET=copiar-el-mismo-JWT_SECRET-de-identity
JWT_ISSUER=carwash-identity
JWT_AUDIENCE=carwash-platform

# Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=customer-service
KAFKA_GROUP_ID=customer-service-group
KAFKA_ORDER_EVENT_TOPICS=wash-order.order.events
KAFKA_AUTO_OFFSET_RESET=earliest

# Worker de Transactional Outbox
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
