# Servidor HTTP de Payment Service
PORT=3003

# PostgreSQL: base de datos propia de Payment (carwash_payments).
# Copiar este archivo como .env (en la carpeta payment/) y reemplazar TU_PASSWORD por la del usuario postgres.
# La base debe existir (crearla en pgAdmin); la tabla "payments" se crea sola al arrancar.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD
DB_NAME=carwash_payments

# Apache Kafka: Payment publica el evento PaymentRegistered (lo escucha Notification).
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-service

# JWT de Identity Service: deben ser EXACTAMENTE los mismos valores de identity/.env y api-gateway/.env.
# Obligatorio: sin JWT_SECRET el servicio no arranca.
JWT_SECRET=copiar-el-mismo-JWT_SECRET-de-identity
JWT_ISSUER=carwash-identity
JWT_AUDIENCE=carwash-platform
