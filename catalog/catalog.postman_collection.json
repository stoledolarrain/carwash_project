        {
          "name": "3. GET /api/catalog/services/:id — Consultar servicio activo por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK con los campos obligatorios del servicio activo', function () {",
