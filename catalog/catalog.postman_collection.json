    },
    {
      "name": "Consulta por lote",
      "description": "Endpoint de integración síncrona para Wash Order Service (`POST /api/catalog/services/batch`).",
      "item": [
        {
          "name": "1. POST /api/catalog/services/batch — Consultar múltiples IDs (existentes y notFound)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK y JSON válido', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test('Devuelve arreglos services y notFound', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.services).to.be.an('array');",
                  "  pm.expect(body.notFound).to.be.an('array');",
                  "  pm.expect(body.notFound).to.include(pm.collectionVariables.get('missingId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{serviceId}}\",\n    \"{{missingId}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services/batch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "services", "batch"]
            },
            "description": "Devuelve los servicios encontrados (incluyendo su precio en BOB, duración estimada y estado `isActive`) junto con la lista `notFound`."
          }
        }
      ]
    },
    {
      "name": "Casos de error",
      "description": "Pruebas negativas para verificar las validaciones HTTP (400), no encontrado (404), conflictos de negocio (409) y seguridad (401/403).",
      "item": [
        {
          "name": "1. Nombre vacío (400 VALIDATION_ERROR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 VALIDATION_ERROR', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"   \",\n  \"price\": 50,\n  \"estimatedDuration\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/admin/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "admin", "services"]
            },
            "description": "Verifica que se rechace un nombre vacío o de solo espacios con 400 VALIDATION_ERROR."
          }
        },
        {
          "name": "2. Nombre demasiado largo (> 100 caracteres) (400 VALIDATION_ERROR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 VALIDATION_ERROR', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nombre excesivamente largo que supera el limite maximo permitido de cien caracteres en el catalogo de servicios de lavado\",\n  \"price\": 50,\n  \"estimatedDuration\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/admin/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "admin", "services"]
            },
            "description": "Verifica que un nombre de más de 100 caracteres sea rechazado con 400 VALIDATION_ERROR."
          }
        },
        {
          "name": "3. Descripción de más de 500 caracteres (400 VALIDATION_ERROR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 VALIDATION_ERROR', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TEST - Descripcion Larga\",\n  \"description\": \"\",\n  \"price\": 50,\n  \"estimatedDuration\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/admin/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "admin", "services"]
            },
            "description": "Verifica que una descripción mayor a 500 caracteres sea rechazada con 400 VALIDATION_ERROR."
          }
        },
        {
          "name": "4. Precio negativo (400 VALIDATION_ERROR)",
          "event": [
            {
              "listen": "test",
              "script": {
