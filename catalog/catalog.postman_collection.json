            "description": "Lista todos los servicios (activos e inactivos) ordenados alfabéticamente por nombre."
          }
        },
        {
          "name": "4. PUT /api/catalog/admin/services/:id — Actualizar datos generales",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK y actualiza descripción y duración', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('serviceId'));",
                  "  pm.expect(body.estimatedDuration).to.eql(55);",
                  "  pm.expect(body.version).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{serviceName}}\",\n  \"description\": \"Servicio actualizado: lavado exterior, interior, aspirado y silicona\",\n  \"estimatedDuration\": 55\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/admin/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "admin", "services", "{{serviceId}}"]
            },
            "description": "Actualiza los datos generales (`name`, `description`, `estimatedDuration`) del servicio identificado por `{{serviceId}}`."
          }
        },
        {
          "name": "5. PATCH /api/catalog/admin/services/:id/price — Cambiar precio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK y actualiza el precio en BOB', function () {",
                  "  pm.response.to.have.status(200);",
