# Servidor HTTP
NODE_ENV=development
PORT=3002

# PostgreSQL 18 (base de datos propia de Catalog: catalog_db).
# Sustituir <usuario> y <contraseña> por las credenciales locales en el archivo .env (no versionado).
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/catalog_db

# Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=catalog-service
KAFKA_GROUP_ID=catalog-service-group

# Worker del Transactional Outbox
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50

# Contexto de autenticación local solo para desarrollo/pruebas manuales (ignorado en production).
# Valores de ejemplo: ADMIN, OPERATOR. Dejar vacío para simular peticiones sin autenticar (401).
# DEV_AUTH_ROLE=ADMIN
