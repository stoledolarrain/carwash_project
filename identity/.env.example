# Servidor HTTP
NODE_ENV=development
PORT=3001
# Proxies de confianza delante del servicio (poner 1 cuando las peticiones lleguen por el API Gateway)
TRUST_PROXY=0

# PostgreSQL: base propia del servicio (identity_db). Reemplazar TU_CONTRASEÑA por la del usuario postgres.
# Si se deja vacío fuera de producción, los usuarios se guardan en memoria y se pierden al reiniciar.
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/identity_db

# JWT (OBLIGATORIO). Usar una cadena aleatoria de al menos 32 caracteres.
# Generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El API Gateway y los demás microservicios deben compartir este mismo secreto, emisor y audiencia.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+
JWT_EXPIRES_IN=1h
JWT_ISSUER=carwash-identity
JWT_AUDIENCE=carwash-platform

BCRYPT_ROUNDS=10

# Administrador inicial: se crea al arrancar SOLO si no existe ningún usuario.
# La contraseña debe cumplir la política: mínimo 8 caracteres, con letras y números.
ADMIN_EMAIL=admin@carwash.local
ADMIN_PASSWORD=Admin12345
ADMIN_FULL_NAME=Administrador General

# Límite de intentos de login por IP
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
